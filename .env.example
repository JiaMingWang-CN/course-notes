# Narration provider: browser (free local Web Speech API) or fish_audio
TTS_PROVIDER=browser

# Fish Audio settings. Copy this file to .env and never commit the real key.
# Get an API key from Fish Audio, then run: python scripts/configure_fish_audio.py
FISH_API_KEY=
FISH_AUDIO_LANGUAGE=zh-CN
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_SPEED=1.0
